# MuClip configuration.
# Copy this file to `.env` if you want to launch with environment variables,
# then load it with:  set -a; source .env; set +a
# (You can also skip env vars entirely and type the keys in the app's
#  Settings panel — they are persisted in store.json, which is gitignored.)

# AssemblyAI API key — speech-to-text with word-level timestamps.
# Get one at https://www.assemblyai.com/
MUCLIP_ASSEMBLY_KEY=

# OpenRouter API key — used only for LLM scene suggestions.
# Get one at https://openrouter.ai/
MUCLIP_OPENROUTER_KEY=

# LLM model used for scene suggestions (OpenRouter model id).
MUCLIP_MODEL=deepseek/deepseek-v4-flash-0731

# Host/port for the built-in launcher (`uv run server.py`).
MUCLIP_HOST=127.0.0.1
MUCLIP_PORT=8010